# ─────────────────────────────────────────────────────────────────────────────
#  MODÈLE — ne pas remplir ici.
#  Copiez ce fichier en `keystore.properties` (à la racine du projet) puis
#  renseignez les valeurs de votre keystore de signature.
#
#  ⚠️  Ne JAMAIS committer `keystore.properties` ni le fichier .keystore/.jks
#      (ils sont déjà dans .gitignore).
# ─────────────────────────────────────────────────────────────────────────────

# Chemin absolu ou relatif vers votre fichier keystore (généré avec keytool).
# Exemple : /home/moi/.keystores/hidesms-release.jks
storeFile=/chemin/absolu/vers/hidesms-release.jks

# Mot de passe du keystore lui-même.
storePassword=CHANGE_ME_STORE_PASSWORD

# Alias de la clé de signature (choisi lors de la création du keystore).
keyAlias=hidesms

# Mot de passe de la clé (peut être identique au mot de passe du keystore).
keyPassword=CHANGE_ME_KEY_PASSWORD
